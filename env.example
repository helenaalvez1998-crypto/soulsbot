# Exemplo de variáveis de ambiente da NARA. Nunca coloque chaves reais neste arquivo.
DISCORD_TOKEN=
GUILD_ID=
NARA_CHANNEL_ID=

# Canal privado do Discord usado como biblioteca e fila de revisão das artes do Coliseu.
COLISEU_ART_CHANNEL_ID=

# Catálogo absorvido: pasta que contém jogos.db, capas/ e capas_mods/.
# Se os dados antigos estiverem em outro volume, aponte para a pasta original.
CATALOGO_DATA_DIR=

# Comunidade: Arquivo de Mundos, guias e contribuições gerais.
LORE_CHANNEL_ID=
GUIDES_CHANNEL_ID=
COMMUNITY_CHANNEL_ID=
COMMUNITY_XP_DEFAULT=10
COMMUNITY_XP_WEEKLY_CAP=50
