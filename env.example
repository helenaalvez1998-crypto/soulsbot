# NARA — variáveis de ambiente. Copie para .env (local) ou cadastre no painel da hospedagem.
# Nunca coloque chaves reais neste arquivo. Valores abaixo são os padrões do código.

# ── Obrigatórias ─────────────────────────────────────────────
DISCORD_TOKEN=
GUILD_ID=                      # ID do servidor (sem isso os comandos sincronizam globalmente, mais lento)
MOD_CHANNEL_ID=                # canal central de aprovação/moderação
MOD_ROLE_ID=                   # cargo de moderador
BOT_OWNER_ID=                  # seu ID (painéis privados de administração e aprovação do Ateliê)
COLISEUM_ART_REVIEWER_IDS=     # IDs Discord adicionais autorizados a aprovar artes, separados por vírgula

# ── Armazenamento ────────────────────────────────────────────
# Na FadeHost use DATA_DIR=/data. Se vazio: usa /data se existir, senão ./data
DATA_DIR=
DB_PATH=                       # padrão: <DATA_DIR>/colizeu.db
CATALOGO_DATA_DIR=             # pasta com jogos.db, capas/ e capas_mods/ (padrão: DATA_DIR)
GWENT_RENDER_CONCURRENCY=4     # renderizadores Pillow simultâneos (2–6; padrão 4)
PORT=8080
LOG_LEVEL=INFO

# ── Canais (também configuráveis pelo painel /adm) ───────────
NARA_CHANNEL_ID=
PLATINAS_CHANNEL_ID=
ZERADOS_CHANNEL_ID=
SOULSLIKE_CHANNEL_ID=
COLIZEU_CHANNEL_ID=
PERFIS_CHANNEL_ID=
GAMES_CHANNEL_ID=
PROMOS_CHANNEL_ID=
LORE_CHANNEL_ID=
GUIDES_CHANNEL_ID=
COMMUNITY_CHANNEL_ID=
CREATOR_VIDEO_CHANNEL_ID=
CREATOR_LIVE_CHANNEL_ID=
COLISEU_ART_CHANNEL_ID=        # canal privado das artes das cartas (Ateliê)
SOULSBOT_DUELOS_CHANNEL_ID=0   # canal dos convites de duelo

# ── Economia ─────────────────────────────────────────────────
XP_PLATINA=200
DENARIOS_PLATINA=50
XP_ZERADO=50
DENARIOS_ZERADO=10
ZERADOS_XP_LIMITE_DIARIO=3
COMMUNITY_XP_DEFAULT=10
COMMUNITY_XP_WEEKLY_CAP=50

# ── Site (login Discord + duelos) ────────────────────────────
SOULSBOT_PUBLIC_URL=https://narabot.sbs
SOULSBOT_WEB_SESSION_SECRET=   # mínimo 32 caracteres aleatórios
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=    # ex.: https://seu-dominio/auth/discord/callback

# ── IA da Nara (opcional; sem chave ela só usa respostas locais) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_API_KEY=
GEMINI_BACKUP_MODEL=
GEMINI_THIRD_API_KEY=
GEMINI_THIRD_MODEL=
NARA_CHAT_IA_ENABLED=false
IA_CANAIS_LIVRES=              # IDs de canais separados por vírgula
IA_LIMITE_DIARIO=3
IA_ACOES_MODERACAO=false
NARA_DUVIDAS_LIMPEZA_ENABLED=true
NARA_DUVIDAS_LIMPEZA_INTERVALO_MINUTOS=30

# ── YouTube (opcional) ───────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_VIDEO_CHECK_SECONDS=120
YOUTUBE_LIVE_CHECK_MINUTES=10
LIVE_START_HOUR=19
LIVE_END_HOUR=24
ROLE_VIDEO_NAME=🔔 Avisos de Vídeo
ROLE_LIVE_NAME=🔴 Avisos de Live

# ── Ofertas de jogos (opcional) ──────────────────────────────
OFFERS_CHECK_MINUTES=15
MAX_OFFERS_PER_CHECK=15
MIN_PROMO_DISCOUNT=50
GG_DEALS_API_KEY=
ITAD_API_KEY=
ITAD_SHOPS=50
OFFERS_GOG_ENABLED=true
OFFERS_SHOW_DESCRIPTION=false
SEED_OFFERS_ON_FIRST_RUN=true

# ── Avançado ─────────────────────────────────────────────────
CLEAR_GLOBAL_COMMANDS_ON_GUILD_SYNC=false
DISCORD_INVITE_URL=             # (opcional) link de convite do servidor; aparece como botão "Entrar no Discord" no site
