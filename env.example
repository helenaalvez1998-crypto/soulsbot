# Copie para .env (local) ou cadastre estas variáveis no painel da FadeHost.
# NUNCA suba o .env para o GitHub.
DISCORD_TOKEN=
GUILD_ID=0
MOD_CHANNEL_ID=0
PLATINAS_CHANNEL_ID=0
COLIZEU_CHANNEL_ID=0
MOD_ROLE_ID=0
PERFIS_CHANNEL_ID=0
DB_PATH=data/colizeu.db

# --- Ofertas de jogos ---
# Opcional: chave da API GG.deals para comparação de preços em região brasileira.
GG_DEALS_API_KEY=
# Opcional: chave GRATUITA da IsThereAnyDeal (https://isthereanydeal.com/apps/my/ -> Register App).
# Ativa as promoções da Nuuvem (loja brasileira, em reais) e giveaways extras.
ITAD_API_KEY=
# IDs de lojas da ITAD, separados por vírgula. Padrão: 50 (Nuuvem). Steam/Epic/GOG já são consultadas direto.
ITAD_SHOPS=50
# GOG (catálogo público em BRL, sem chave). Use false para desligar.
OFFERS_GOG_ENABLED=true
# Cartões limpos não mostram descrição. true = mostra um resumo curto (traduzido se houver Gemini).
OFFERS_SHOW_DESCRIPTION=false

# --- configurações herdadas da instalação anterior (nomes preservados) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCBuR1KPa9g9yYilBiy_7iqw
CREATOR_VIDEO_CHANNEL_ID=1563040916074405979
CREATOR_LIVE_CHANNEL_ID=1563040917298872340
GAMES_CHANNEL_ID=1563071436724248627
PROMOS_CHANNEL_ID=1563103272494039092
# opcionais: YOUTUBE_VIDEO_CHECK_SECONDS=120  YOUTUBE_LIVE_CHECK_MINUTES=10
#            OFFERS_CHECK_MINUTES=30  MAX_OFFERS_PER_CHECK=8  MIN_PROMO_DISCOUNT=50

# Canal onde anúncios de runs e recordes Soulslike são publicados
SOULSLIKE_CHANNEL_ID=0

# --- IA da Nara + pesquisa do Caçador de Troféus (somente Gemini + busca gratuita) ---
# Os dois modelos Gemini fazem análise/texto. Use projetos Google diferentes para circuitos independentes.
# Duas chaves do mesmo projeto compartilham a quota. NÃO vincule faturamento se não quiser pagar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_QUOTA_COOLDOWN_SECONDS=21600
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
GEMINI_UNAVAILABLE_COOLDOWN_SECONDS=45
GEMINI_AUTH_COOLDOWN_SECONDS=3600
GEMINI_CIRCUIT_STATE_FILE=data/gemini_circuit.json

GEMINI_BACKUP_API_KEY=
GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_QUOTA_COOLDOWN_SECONDS=21600
GEMINI_BACKUP_RATE_LIMIT_COOLDOWN_SECONDS=60
GEMINI_BACKUP_UNAVAILABLE_COOLDOWN_SECONDS=45
GEMINI_BACKUP_AUTH_COOLDOWN_SECONDS=3600
GEMINI_BACKUP_CIRCUIT_STATE_FILE=data/gemini_backup_circuit.json

# Pesquisa web gratuita. Crie chave no plano Tavily Free/Researcher (1.000 créditos mensais publicados).
# Use Search Basic; NÃO habilite Pay-as-you-go, upgrade ou compra automática de créditos.
TAVILY_API_KEY=
TAVILY_MAX_QUERIES_PER_JOB=4
TAVILY_CIRCUIT_STATE_FILE=data/tavily_circuit.json

IA_LIMITE_DIARIO=3
# false = economia máxima: chat não chama IA; pesquisas do Caçador usam Tavily Free + Gemini.
NARA_CHAT_IA_ENABLED=false

# --- Jogos zerados ---
# Canal onde os zerados são anunciados (vazio/0 = não anuncia, só registra)
ZERADOS_CHANNEL_ID=0
XP_ZERADO=50
DENARIOS_ZERADO=10
# Quantos zerados por 24h rendem XP (0 = sem limite)
ZERADOS_XP_LIMITE_DIARIO=3
