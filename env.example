# Copie para .env (local) ou cadastre estas variáveis no painel da FadeHost.
# NUNCA suba o .env para o GitHub.
DISCORD_TOKEN=cole_o_token_aqui
GUILD_ID=id_do_seu_servidor
MOD_CHANNEL_ID=id_do_canal_onde_moderadores_aprovam
PLATINAS_CHANNEL_ID=id_do_canal_de_anuncios_de_platinas
COLIZEU_CHANNEL_ID=id_do_canal_colizeu_com_o_painel_de_ranking
MOD_ROLE_ID=id_do_cargo_de_moderador
PERFIS_CHANNEL_ID=id_do_canal_dos_santuarios
DB_PATH=data/colizeu.db

# --- Ofertas de jogos ---
# Opcional: chave da API GG.deals para comparação de preços em região brasileira.
GG_DEALS_API_KEY=

# --- configurações herdadas da instalação anterior (nomes preservados) ---
YOUTUBE_API_KEY=sua_chave_da_youtube_data_api
YOUTUBE_CHANNEL_ID=UCBuR1KPa9g9yYilBiy_7iqw
CREATOR_VIDEO_CHANNEL_ID=1563040916074405979
CREATOR_LIVE_CHANNEL_ID=1563040917298872340
GAMES_CHANNEL_ID=1563071436724248627
PROMOS_CHANNEL_ID=1563103272494039092
# opcionais: YOUTUBE_VIDEO_CHECK_SECONDS=120  YOUTUBE_LIVE_CHECK_MINUTES=10
#            OFFERS_CHECK_MINUTES=30  MAX_OFFERS_PER_CHECK=8  MIN_PROMO_DISCOUNT=50

# Canal onde anúncios de runs e recordes Soulslike são publicados
SOULSLIKE_CHANNEL_ID=id_do_canal_de_runs

# --- IA da Nara (Gemini) ---
GEMINI_API_KEY=cole_a_chave_do_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite
IA_LIMITE_DIARIO=0
# Canais (IDs separados por vírgula) onde a IA responde dúvidas da comunidade SEM precisar de menção.
# Vazio = só responde quando marcada. Perguntas que exigem pesquisa nos jogos sempre pedem a marcação.
IA_CANAIS_LIVRES=COLOQUE_ID_DO_CANAL_DE_DUVIDAS
IA_TETO_ESPONTANEO=0
IA_COOLDOWN_CANAL=0

# --- Jogos zerados ---
# Canal onde os zerados são anunciados (vazio/0 = não anuncia, só registra)
ZERADOS_CHANNEL_ID=id_do_canal_de_zerados
XP_ZERADO=50
DENARIOS_ZERADO=10
# Quantos zerados por 24h rendem XP (0 = sem limite)
ZERADOS_XP_LIMITE_DIARIO=3
